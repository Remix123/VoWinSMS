<Application
    x:Class="VoWin.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    DispatcherUnhandledException="OnDispatcherUnhandledException"
    Exit="OnExit"
    ShutdownMode="OnMainWindowClose"
    Startup="OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Themes/DesignSystem.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Use the Windows message font so Win11 font settings and native
                 CJK fallback are respected instead of shipping a custom font. -->
            <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>

            <!-- Brand-blue interaction defaults; App.ApplyBrandTheme refreshes
                 these values for light and dark themes at runtime. -->
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#2563EB" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#1D4ED8" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#1E40AF" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#2563EB" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#1D4ED8" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#1E40AF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="#522563EB" />

            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#2563EB" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#1D4ED8" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#1E40AF" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#2563EB" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="#1E40AF" />
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#FFFFFF" />

        </ResourceDictionary>
    </Application.Resources>
</Application>
