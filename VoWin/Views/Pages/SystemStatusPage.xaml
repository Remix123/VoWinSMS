<Page
  x:Class="VoWin.Views.Pages.SystemStatusPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:helpers="clr-namespace:VoWin.Helpers"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:VoWin.ViewModels.Pages"
  Title="系统状态"
  d:DataContext="{d:DesignInstance vm:SystemStatusViewModel, IsDesignTimeCreatable=False}"
  d:DesignHeight="750"
  d:DesignWidth="1200"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource AppTextPrimaryBrush}"
  Foreground="{DynamicResource AppTextPrimaryBrush}"
  ScrollViewer.VerticalScrollBarVisibility="Disabled"
  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
  mc:Ignorable="d"
>
  <Page.Resources>
    <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
    <helpers:SlotStateToColorConverter x:Key="SlotStateColor" />
    <helpers:SlotStateToTextConverter x:Key="SlotStateText" />
    <Style x:Key="LogFilterButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Appearance" Value="Transparent" />
    </Style>
  </Page.Resources>
  <Grid Margin="24,18,24,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Style="{DynamicResource AppPageTitleStyle}" Text="系统状态" />
        <TextBlock Style="{DynamicResource AppPageSubtitleStyle}" Text="汇总通信模块状态、蜂窝网络信息与 IMS / SIP 保活质量" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <ui:ProgressRing Width="16" Height="16" Margin="0,0,10,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        <ui:Button Appearance="Secondary" Command="{Binding RefreshMetricsCommand}" Icon="{ui:SymbolIcon Symbol=ArrowSync24}" Content="刷新状态" />
      </StackPanel>
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <Border Margin="0,0,0,14" Padding="18,16" Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="12">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Pulse24" FontSize="16" Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock FontSize="15" FontWeight="SemiBold" Text="系统总状态" VerticalAlignment="Center" /></StackPanel>
              <TextBlock Margin="0,10,0,0" FontSize="18" FontWeight="SemiBold" Text="通信模块状态汇总" />
              <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="详细信息见下方“蜂窝网络与 SIM”区域" />
            </StackPanel>
            <Border Grid.Column="1" Padding="10,6" Background="{DynamicResource AppSuccessSoftBrush}" CornerRadius="8" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{DynamicResource AppSuccessBrush}" Margin="0,0,7,0" VerticalAlignment="Center" /><TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppSuccessBrush}" VerticalAlignment="Center"><Run Text="{Binding Slots.Count, Mode=OneWay}" /><Run Text=" 个模块已接入" /></TextBlock></StackPanel>
            </Border>
          </Grid>
        </Border>
        <Border Margin="0,0,0,14" Padding="18,16" Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="12">
          <StackPanel>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="CellularData124" FontSize="16" Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock FontSize="15" FontWeight="SemiBold" Text="蜂窝网络与 SIM" VerticalAlignment="Center" /></StackPanel>
              <TextBlock Grid.Column="1" FontSize="11" Foreground="{DynamicResource AppTextTertiaryBrush}" Text="{Binding Slots.Count, Mode=OneWay, StringFormat='{}{0} 个模块'}" VerticalAlignment="Center" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Slots}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Width="270" MinHeight="176" Margin="0,0,12,12" Padding="14" Background="{DynamicResource AppInputBrush}" BorderBrush="{DynamicResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="10">
                    <Grid>
                      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                      <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Ellipse Width="8" Height="8" Fill="{Binding State, Converter={StaticResource SlotStateColor}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="{Binding Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" /><TextBlock FontSize="11" Foreground="{DynamicResource AppTextTertiaryBrush}" Text="{Binding PortName, Mode=OneWay}" /></StackPanel>
                        <Border Grid.Column="2" Padding="5,1" VerticalAlignment="Top" Background="{DynamicResource AppSuccessSoftBrush}" CornerRadius="5"><TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppSuccessBrush}" Text="{Binding State, Converter={StaticResource SlotStateText}, Mode=OneWay}" /></Border>
                      </Grid>
                      <TextBlock Grid.Row="1" Margin="16,14,0,0" FontSize="14" FontWeight="SemiBold" Text="{Binding CarrierName, Mode=OneWay, FallbackValue='未知运营商'}" TextTrimming="CharacterEllipsis" />
                      <StackPanel Grid.Row="2" Margin="16,4,0,0">
                        <TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"><Run Text="PLMN " /><Run Text="{Binding Sim.Mcc, Mode=OneWay, FallbackValue='--'}" /><Run Text="-" /><Run Text="{Binding Sim.Mnc, Mode=OneWay, FallbackValue='--'}" /><Run Text=" · " /><Run Text="{Binding Signal.Rat, Mode=OneWay, FallbackValue='--'}" /></TextBlock>
                        <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource AppTextTertiaryBrush}" Text="{Binding Registration.StatusDisplay, Mode=OneWay, FallbackValue='网络状态未知'}" />
                      </StackPanel>
                      <Grid Grid.Row="3" Margin="16,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock FontSize="10" Foreground="{DynamicResource AppTextTertiaryBrush}" Text="IMSI" /><TextBlock FontSize="11" Text="{Binding Sim.Imsi, Mode=OneWay, FallbackValue='--'}" TextTrimming="CharacterEllipsis" /></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock FontSize="10" Foreground="{DynamicResource AppTextTertiaryBrush}" Text="SIM" /><TextBlock FontSize="11" Text="{Binding Sim.Iccid, Mode=OneWay, FallbackValue='未插卡'}" TextTrimming="CharacterEllipsis" /></StackPanel>
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Padding="18,16" Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="12">
          <StackPanel>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Pulse24" FontSize="16" Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock FontSize="15" FontWeight="SemiBold" Text="IMS / SIP 网络质量与保活" VerticalAlignment="Center" /></StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal"><ui:Button Margin="0,0,8,0" Padding="10,3" Appearance="Secondary" Command="{Binding SendSipProbeCommand}" IsEnabled="{Binding Stage3Success, Mode=OneWay}" Content="立即探测" /><Border Padding="8,3" Background="{Binding Stage4Bg, Mode=OneWay}" CornerRadius="6"><TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding Stage4Brush, Mode=OneWay}" Text="{Binding SipProbeStatus, Mode=OneWay}" /></Border></StackPanel>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="IMS 注册状态" /><TextBlock FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" Text="{Binding VoWifiDiag.Ims.RegistrationState, Mode=OneWay, FallbackValue='未注册'}" TextTrimming="CharacterEllipsis" /><TextBlock FontSize="11" Foreground="{DynamicResource AppTextTertiaryBrush}" Margin="0,2,0,0" Text="SIP 核心网响应" /></StackPanel>
              <StackPanel Grid.Column="1" Margin="4,0,8,0"><TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="往返延迟 (RTT)" /><TextBlock FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" Text="{Binding SipProbeRtt, Mode=OneWay}" /><TextBlock FontSize="11" Foreground="{DynamicResource AppTextTertiaryBrush}" Margin="0,2,0,0" Text="{Binding LastProbeStatusText, Mode=OneWay}" /></StackPanel>
              <StackPanel Grid.Column="2" Margin="4,0,8,0"><TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="保活统计" /><TextBlock FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" Text="{Binding SipProbeCountText, Mode=OneWay}" TextTrimming="CharacterEllipsis" /><TextBlock FontSize="11" Foreground="{DynamicResource AppTextTertiaryBrush}" Margin="0,2,0,0" Text="{Binding LastHeartbeatRelativeText, Mode=OneWay}" /></StackPanel>
              <StackPanel Grid.Column="3" Margin="4,0,0,0"><TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="NAT 映射与端点" /><TextBlock FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" Text="{Binding NatBindingText, Mode=OneWay}" TextTrimming="CharacterEllipsis" /><TextBlock FontSize="11" Foreground="{DynamicResource AppTextTertiaryBrush}" Margin="0,2,0,0"><Run Text="IP: " /><Run Text="{Binding AssignedIp, Mode=OneWay}" /><Run Text=" · P-CSCF: " /><Run Text="{Binding PcscfIp, Mode=OneWay}" /></TextBlock></StackPanel>
            </Grid>
          </StackPanel>
        </Border>
            <Border Margin="0,14,0,0" Padding="18,16" Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="8" PreviewMouseWheel="OnTerminalPreviewMouseWheel">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="260" /></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Code24" Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,6,0" FontSize="16" /><TextBlock FontSize="14" FontWeight="SemiBold" Text="实时日志" VerticalAlignment="Center" /><Border Margin="6,0,0,0" Padding="6,2" Background="{DynamicResource AppCardBrush}" CornerRadius="4"><TextBlock FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding FilteredLogsCountText, Mode=OneWay}" /></Border></StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal"><ui:Button Appearance="Transparent" Padding="6,2" Margin="0,0,4,0" Command="{Binding ToggleAutoScrollCommand}" Content="{Binding AutoScrollStatusText, Mode=OneWay}" /><ui:Button Appearance="Transparent" Padding="6,2" Margin="0,0,2,0" Command="{Binding ExportImsDiagnosticsCommand}" Content="导出" /><ui:Button Appearance="Transparent" Padding="6,2" Margin="0,0,2,0" Command="{Binding CopyLogsCommand}" Icon="{ui:SymbolIcon Symbol=Copy24}" ToolTip="复制全部日志" /><ui:Button Appearance="Transparent" Padding="6,2" Command="{Binding ClearLogsCommand}" Icon="{ui:SymbolIcon Symbol=Delete24}" ToolTip="清空实时日志" /></StackPanel>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6"><ui:Button Content="全部" Command="{Binding SetLogModuleCommand}" CommandParameter="全部" Style="{StaticResource LogFilterButtonStyle}" /><ui:Button Content="Modem" Command="{Binding SetLogModuleCommand}" CommandParameter="Modem" Style="{StaticResource LogFilterButtonStyle}" /><ui:Button Content="VoWiFi" Command="{Binding SetLogModuleCommand}" CommandParameter="VoWiFi" Style="{StaticResource LogFilterButtonStyle}" /><ui:Button Content="IMS" Command="{Binding SetLogModuleCommand}" CommandParameter="IMS" Style="{StaticResource LogFilterButtonStyle}" /><ui:Button Content="SIP" Command="{Binding SetLogModuleCommand}" CommandParameter="SIP" Style="{StaticResource LogFilterButtonStyle}" /></StackPanel>
                <ui:TextBox Grid.Row="2" Margin="0,0,0,8" Padding="8,3" FontSize="11" PlaceholderText="搜索日志内容..." Text="{Binding LogSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="True" />
                <ListBox x:Name="LogList" Grid.Row="3" ItemsSource="{Binding FilteredLogs}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" Focusable="False">
                  <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,4" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Focusable" Value="False" /></Style></ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,1,0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="48" /><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontFamily="{DynamicResource AppFontFamily}" FontSize="10" Foreground="{DynamicResource AppTextTertiaryBrush}" Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}', Mode=OneWay}" />
                        <Border Grid.Column="1" Margin="2,0,4,0" Padding="3,1" CornerRadius="4" HorizontalAlignment="Left" Background="{Binding LevelBackground, Mode=OneWay}"><TextBlock FontFamily="{DynamicResource AppFontFamily}" FontSize="9" FontWeight="Bold" Foreground="{Binding LevelColor, Mode=OneWay}" Text="{Binding Level, Mode=OneWay}" /></Border>
                        <Border Grid.Column="2" Margin="0,0,4,0" Padding="3,1" CornerRadius="4" HorizontalAlignment="Left" Background="{DynamicResource AppCardBrush}"><TextBlock FontFamily="{DynamicResource AppFontFamily}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding Source, Mode=OneWay}" TextTrimming="CharacterEllipsis" /></Border>
                        <TextBlock Grid.Column="3" FontFamily="{DynamicResource AppFontFamily}" FontSize="11" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="{Binding Message, Mode=OneWay}" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
